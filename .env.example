# rb-api-tester — template for .env.
# Setup: copy this file to `.env` (`cp .env.example .env`) and adjust values.
# `.env` is gitignored; this example file is safe to commit.
# Server-only vars are read at runtime; NEXT_PUBLIC_* vars are inlined into
# the browser bundle at build time (restart `next dev` / rebuild after edits).

# --- Upstream API endpoints ---------------------------------------------
# DataAPI: match list / match detail / stream detail.
RB_DATA_API=""
# LiveAPI: live match list / live match detail.
RB_LIVE_API=""

# --- Request identity headers (mimics the original Android app) ---------
RB_USER_AGENT=""
RB_ORIGIN=""

# --- SENSITIVE: AES-256-CTR signing material for play URLs ---------------
# Treat as secrets: override per deployment if needed. Format matters —
# RB_SIGN_KEY must be exactly 32 ASCII chars, RB_SIGN_IV exactly 16 ASCII chars.
RB_SIGN_KEY=""
RB_SIGN_IV=""

# --- Client-exposed defaults (NEXT_PUBLIC_* is inlined into the browser) --
# Logo CDN host for team/league badges (mirrors the app's LOGO_HOST).
NEXT_PUBLIC_RB_LOGO_HOST=""
# Default stream/channel identity used by the player.
NEXT_PUBLIC_RB_STREAM_ID=
NEXT_PUBLIC_RB_CHANNEL_ID=
# Default region for stream resolution.
NEXT_PUBLIC_RB_SITE_TYPE=
NEXT_PUBLIC_RB_CONTINENT=""
NEXT_PUBLIC_RB_COUNTRY=""
# Device registration identity (user-specific in production).
NEXT_PUBLIC_RB_DEVICE_ID=""
# Activation code (user-specific; may be left empty).
NEXT_PUBLIC_RB_ACTIVATION_CODE=""

# Where the tab is redirected when the devtools guard detects opened developer
# tools (F12 / Inspect / eruda / vConsole ...). Optional — defaults to a blank
# page ("about:blank"). Set a same-origin path (e.g. "/blank") to use an in-app
# empty page instead.
NEXT_PUBLIC_DEVTOOLS_BLANK_PATH=""

# --- Production-only features: player ads + devtools guard ----------------
# Both are armed in production builds only (`next build` → `next start`), and
# stay inert while `next dev` runs — local sessions are never interrupted by ad
# tabs or by the devtools redirect. Overrides below (leave empty for defaults):
#   "true"  → arm the feature under `next dev` too (to test the tag locally)
#   "false" → switch the feature off even in production
#
# Devtools guard — F12 / Inspect / right-click detectors, redirecting to
# NEXT_PUBLIC_DEVTOOLS_BLANK_PATH above.
NEXT_PUBLIC_RB_DEVTOOLS_GUARD=""
# Player ads — the Monetag popunder armed on `/watch/[id]` player pages.
NEXT_PUBLIC_RB_PLAYER_ADS=""
# Monetag zone id for the player popunder (empty → built-in zone 12007023).
NEXT_PUBLIC_RB_PLAYER_AD_ZONE=""
# Monetag tag URL for the player popunder (empty → built-in https://al5sm.com/tag.min.js).
NEXT_PUBLIC_RB_PLAYER_AD_SCRIPT_SRC=""

# Contact email shown in the footer "Hubungi Kami" section.
# TODO: replace with your real contact email (.example is a reserved placeholder TLD).
RB_CONTACT_EMAIL=""

# --- Streaming video API (category videos + stream detail) -----------------
# Swap this to your real Third-Party REST API. While empty, the hooks in
# lib/streamingQueries.ts return in-memory mock data so the UI works end-to-end.
NEXT_PUBLIC_STREAM_API_BASE_URL=""
